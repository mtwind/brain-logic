# Filesystem locations. Sourced by cron/ and scripts/ so no path is hardcoded
# in more than one place. Committed on purpose — these are not secrets.

# The brain repo. Must NOT be inside brain-logic.
BRAIN_DIR="$HOME/Code/brain"

# This repo.
BRAIN_LOGIC_DIR="$HOME/Code/brain-logic"

# Postgres dumps (restic picks these up; not in git).
BRAIN_BACKUP_DIR="$HOME/backups/pgdump"

# Off-disk restic repository, e.g. "b2:bucket:brain" or "sftp:host:/path".
# Required by cron/restic-backup.sh; install-cron-agents.sh refuses to load
# the job until it is set. Which backend is the owner's decision -- until it is
# made the only backups share a disk with the database they came from.
# BRAIN_RESTIC_REPO=""

# Database created by scripts/brain-setup.sh
BRAIN_DB_NAME="gbrain"

# Postgres connects over the Unix socket, not TCP. pg_hba is socket-only peer
# auth (scripts/harden-postgres-auth.sh), so the OS user is the credential and
# no local account can reach the database as a role it does not own.
#
# EXPORTED, unlike the paths above: gbrain's client (postgres.js) reads PGHOST
# from the environment. It does NOT honour ?host= in the URL -- it forwards
# that to the server as a startup option and the server rejects it. A bare
# postgresql:///gbrain with no PGHOST silently falls back to TCP, which pg_hba
# now rejects, so a missing PGHOST fails loudly rather than quietly.
export PGHOST="/tmp"
